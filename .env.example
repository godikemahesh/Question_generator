# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Generation Settings
GENERATION_BATCH_SIZE=12
PAUSE_BETWEEN_BATCHES_SECONDS=30
MAX_REQUESTS_PER_MINUTE=10

# Quality Thresholds
QUALITY_APPROVE_THRESHOLD=70
QUALITY_MONITOR_THRESHOLD=70
QUALITY_REVISION_THRESHOLD=70

# Duplicate Detection
DUPLICATE_EXACT_REJECT=true
DUPLICATE_SEMANTIC_THRESHOLD=0.90
DUPLICATE_SEMANTIC_REVIEW_THRESHOLD=0.85

# Test Assembly
MAX_QUESTION_REUSE_DAYS=60
MAX_SAME_CONCEPT_PER_TEST=3
ANSWER_BALANCE_TOLERANCE=0.05

# ── Supabase Cloud Database (Run schema.sql in Supabase SQL Editor) ──────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Multi-Provider LLM Fallback Orchestration ─────────────────────────────────
# Tier 2: OpenRouter API (Fallback + Real-time Web Search for Current Affairs/GK)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Tier 3: Groq API (High-speed Llama 3.3 70B failover)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Free Web Search Providers Cascade (Tavily → Brave → Exa, ~3,428 free searches/mo) ──
# 1. Tavily (1,000 free requests/month): https://app.tavily.com
TAVILY_API_KEY=
# 2. Brave Search ($5/month free tier ~1,000 searches): https://brave.com/search/api/
BRAVE_API_KEY=
# 3. Exa ($10/month free allowance ~1,428 searches): https://exa.ai
EXA_API_KEY=
WEB_SEARCH_ENABLED=true

# ── ExamForge 100-Question Ingestion Webhook ─────────────────────────────────
EXAMFORGE_API_URL=https://examforge-pink.vercel.app/api/questions/ai-ingest
EXAMFORGE_LOCAL_URL=http://localhost:3000/api/questions/ai-ingest
EXAMFORGE_API_KEY=ef_ai_ingest_9a7d3f28e6c41b80d52a7e9140f
EXAMFORGE_BATCH_SIZE=100

